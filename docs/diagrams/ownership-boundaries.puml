component "Replete\ne-graphs and extraction" as replete #FBCFE8
component "Rigail\nsemirings and weighted solvers" as rigail #FED7AA
component "llattice\nlattice domains" as lattice #BBF7D0
component "liblevenshtein + libdictenstein\nindexed domain feeds" as feeds #A7F3D0
component "libvgraph\nstructural graph kernel" as graph #BAE6FD
component "libcpg\nCPG semantics and analyses" as cpg #C7D2FE

optimizer -[#2563EB,bold]-> parser : consumes generated frontend
optimizer -[#DB2777,bold]-> replete : drives saturation
optimizer -[#C2410C,bold]-> rigail : requests weighted solutions
optimizer -[#16A34A,bold]-> lattice : evaluates ordered facts
