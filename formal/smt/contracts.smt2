(set-option :produce-models true)

(echo "CASE exact-promotion-is-impossible")
(declare-const left_exact Bool)
(declare-const right_exact Bool)
(define-fun result_exact () Bool (and left_exact right_exact))
(assert result_exact)
(assert (or (not left_exact) (not right_exact)))
(check-sat)

(reset)
(set-option :produce-models true)
(echo "CASE unconfirmed-exact-validation-is-impossible")
(declare-const exact_result Bool)
(declare-const independently_confirmed Bool)
(declare-const valid Bool)
(assert (= valid (or (not exact_result) independently_confirmed)))
(assert valid)
(assert exact_result)
(assert (not independently_confirmed))
(check-sat)

(reset)
(set-option :produce-models true)
(echo "CASE semiring-times-can-differ-from-meet")
(declare-const x Int)
(declare-const y Int)
(assert (= x 1))
(assert (= y 2))
(define-fun lattice_meet () Int (ite (>= x y) x y))
(assert (not (= (+ x y) lattice_meet)))
(check-sat)
(get-value (x y (+ x y) lattice_meet))

(reset)
(set-option :produce-models true)
(echo "CASE noninjective-map-can-fail-order-reflection")
(declare-const source_left Bool)
(declare-const source_right Bool)
(assert source_left)
(assert (not source_right))
(define-fun source_order () Bool (= (or source_left source_right) source_right))
(define-fun mapped_left () Bool false)
(define-fun mapped_right () Bool false)
(define-fun mapped_order () Bool (= (or mapped_left mapped_right) mapped_right))
(assert mapped_order)
(assert (not source_order))
(check-sat)
(get-value (source_left source_right mapped_order source_order))
